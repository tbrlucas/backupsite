name = "tbrlucas-blog-admin"
main = "worker.js"
compatibility_date = "2026-11-14"

[[kv_namespaces]]
binding = "AUTH_KV"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

[vars]
GITHUB_CLIENT_ID = "REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID"
GITHUB_CALLBACK_URL = "https://REPLACE-WORKER.REPLACE-SUBDOMAIN.workers.dev/auth/callback"
ADMIN_GITHUB_LOGIN = "tbrlucas"
ADMIN_ORIGIN = "https://tbrlucas.github.io"
REPO_OWNER = "tbrlucas"
REPO_NAME = "tbrlucas.github.io"
