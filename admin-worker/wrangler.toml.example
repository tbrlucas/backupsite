name = "tbrlucas-backup-admin"
main = "worker.js"
compatibility_date = "2026-11-15"

[[kv_namespaces]]
binding = "AUTH_KV"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

[vars]
GITHUB_APP_ID = "REPLACE_WITH_GITHUB_APP_ID"
GITHUB_APP_INSTALLATION_ID = "REPLACE_WITH_INSTALLATION_ID"
GITHUB_OAUTH_CLIENT_ID = "REPLACE_WITH_GITHUB_APP_CLIENT_ID"
GITHUB_CALLBACK_URL = "https://REPLACE-WORKER.REPLACE-SUBDOMAIN.workers.dev/auth/callback"
ADMIN_GITHUB_LOGIN = "tbrlucas"
ADMIN_ORIGIN = "https://tbrlucas.github.io"
ADMIN_PATH = "/backupsite/alcatelonetouch3075m/"
REPO_OWNER = "tbrlucas"
REPO_NAME = "backupsite"
